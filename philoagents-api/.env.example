# Qwen (DashScope OpenAI-compatible endpoint) — required to run the game
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Optional: prompt versioning and tracing with Opik
COMET_API_KEY=

# Optional: only used by the legacy evaluation scripts
GROQ_API_KEY=
OPENAI_API_KEY=

OPIK_TRACK_DISABLE=true

# --- HTTP surface ---
# Comma separated browser origins allowed to call the API. docker-compose publishes the game
# UI on host port 8088 (container still 8080); `npm run dev` uses 8080. Any other origin you
# serve the game from has to be added here or the browser blocks every request.
# "*" works only if you also drop credentials, which browsers refuse to combine.
CORS_ORIGINS=http://localhost:8080,http://localhost:8088,http://127.0.0.1:8088
# Hard ceiling for one player message; the game input already caps it at 1000.
MAX_MESSAGE_CHARS=2000
# Per player, per window. Guards the Qwen bill against a stuck or hostile client.
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60
